<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SD Organizer"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Keeps your phone memory empty by moving files to the SD card"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- Storage card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phone memory"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barInternal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    app:trackThickness="10dp"
                    app:trackCornerRadius="5dp" />

                <TextView
                    android:id="@+id/txtInternal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="SD card"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barSd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    app:trackThickness="10dp"
                    app:trackCornerRadius="5dp" />

                <TextView
                    android:id="@+id/txtSd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/txtTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Setup -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Setup (one time)"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccess"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Allow access to files" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSd"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Choose the SD card" />

        <TextView
            android:id="@+id/txtSetup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <!-- Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Move files to SD card"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <Spinner
            android:id="@+id/spinAge"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Include camera photos &amp; videos" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Include WhatsApp &amp; Telegram files" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Moved WhatsApp files open from Gallery or Files, not from inside the chat."
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swTidy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Also reorganize files already on the SD card" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/swThumbs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete gallery thumbnail cache" />

        <!-- Live progress (shown while moving) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/progressCard"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtProgTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moving to SD card"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <TextView
                    android:id="@+id/txtProgPct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barProg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    app:trackThickness="12dp"
                    app:trackCornerRadius="6dp" />

                <TextView
                    android:id="@+id/txtProgBytes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/txtProgFiles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtProgSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtProgCurrent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <!-- Live memory: phone goes down, SD card goes up -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="📱 Phone memory"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barSimPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="1000"
                    app:trackThickness="10dp"
                    app:trackCornerRadius="5dp" />

                <TextView
                    android:id="@+id/txtSimPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="💾 SD card"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barSimSd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="1000"
                    app:indicatorColor="#F2A541"
                    app:trackThickness="10dp"
                    app:trackCornerRadius="5dp" />

                <TextView
                    android:id="@+id/txtSimSd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodySmall" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPause"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="⏸ Pause" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStop"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⏹ Stop" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRun"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="Move &amp; organize now"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <!-- Speed -->
        <TextView
            android:id="@+id/txtSpeedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Speed check"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap any ⚠ item to fix it"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <LinearLayout
            android:id="@+id/speedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnused"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Find apps you don't use" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCache"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open phone cleaner (clear app caches)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnim"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Make animations faster" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tip: phones get slow when phone memory is over 85% full. Keeping it low is the biggest speed boost. Restart the phone once a week."
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</ScrollView>
